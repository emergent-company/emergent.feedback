{
  "name": "vite-plugin-emergent-feedback",
  "version": "0.1.0",
  "description": "Vite plugin that stamps JSX/TSX DOM elements with data-fo-src (repo-relative path:line:col) at compile time, so a clicked element can be mapped to its exact source in production builds.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./src": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/transform.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "feedback",
    "jsx",
    "tsx",
    "source-map",
    "devtools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "vite": ">=4"
  },
  "dependencies": {
    "@babel/generator": "^7.25.0",
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@babel/types": "^7.25.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
