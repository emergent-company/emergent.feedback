{
  "name": "emergent-feedback-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --format=iife --global-name=EmergentFeedback --outfile=../server/static/emergent-feedback.js",
    "build:dev": "esbuild src/index.ts --bundle --format=iife --global-name=EmergentFeedback --outfile=../server/static/emergent-feedback.js --sourcemap",
    "watch": "esbuild src/index.ts --bundle --format=iife --global-name=EmergentFeedback --outfile=../server/static/emergent-feedback.js --sourcemap --watch"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "rrweb": "^2.1.6"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
