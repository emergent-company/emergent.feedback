# GitHub OAuth app credentials (required for sign-in).
GH_APP_CLIENT_ID=your_client_id_here
GH_APP_CLIENT_SECRET=your_client_secret_here
GH_REDIRECT_URI=https://feedback.emergent-company.ai/auth/callback

# Optional GitHub App bot (issue authoring). ISSUE_AUTHOR_MODE=bot uses the App
# if configured, else GH_BOT_TOKEN, else falls back to each reporter's token.
# GH_APP_ID=...
# GH_APP_PRIVATE_KEY=...
# GH_APP_PRIVATE_KEY_PATH=/run/secrets/gh-app.pem
# GH_INSTALLATION_ID=...
#
# ISSUE_AUTHOR_MODE=user authors issues with each reporter's own token. That
# needs either a GitHub OAuth App (the "repo" scope is requested on login) or a
# GitHub App whose "Issues" repository permission is Read & write.
ISSUE_AUTHOR_MODE=bot
GH_BOT_TOKEN=

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_random_32_byte_hex_string

# Server config
PORT=8080
DB_PATH=/data/feedback-overlay.db

# Optional: enables the MCP endpoint at /mcp. Agents authenticate with
# "Authorization: Bearer <MCP_API_KEY>". Leave empty to disable MCP.
MCP_API_KEY=

# Optional (Phase C — PR #8): LLM auto-title. When FEEDBACK_LLM_BASE_URL and
# FEEDBACK_LLM_API_KEY are set, POST {base}/chat/completions produces a concise
# title (2s cap, falls back to the deterministic heuristic). FEEDBACK_LLM_MODEL
# defaults to gpt-4o-mini. Leave empty to disable.
FEEDBACK_LLM_BASE_URL=
FEEDBACK_LLM_API_KEY=
FEEDBACK_LLM_MODEL=

# Optional: webhook URL to POST lifecycle events (resolved/verified) to. Leave empty to disable.
FEEDBACK_NOTIFY_WEBHOOK=

# Comma-separated allowed CORS origins (use * to allow all)
ALLOWED_ORIGINS=*

# IP of your internal reverse proxy (e.g. Traefik) — used in extra_hosts so
# the container can resolve your public domain internally. Remove or leave
# blank if you use external DNS resolution instead.
TRAEFIK_HOST=
